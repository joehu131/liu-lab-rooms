{
  "always_run_in_app" : false,
  "icon" : {
    "color" : "light-brown",
    "glyph" : "magic"
  },
  "name" : "Check available lab rooms HT25",
  "script" : "\/\/ ───────────────────────────────────────────────\n\/\/ TimeEdit Free Labs Widget (Scriptable, iOS)\n\/\/ - Shows only FREE LAB ROOMS (whitelist only)\n\/\/ - Small widget format\n\/\/ - ALWAYS logs process & data to console\n\/\/ ───────────────────────────────────────────────\n\n\/\/ ====== CONFIG ======\nconst ICS_URL = \"https:\/\/cloud.timeedit.net\/liu\/web\/schema\/ri66XXQ9511Z55Qm8X094886y8Y130866Y15Y8gQ0075961ZX68966389082178X9916163008X28818911X599X668X8898513X2X1119908X8X26888181X9XX6959X8X8839586119644769516968XXX989n66455998568Y5W1Z9Q6150.ics\";\n\nconst VALID_ROOMS = [\n  \"Asgård\", \"Bakdörren\", \"Brandväggen\", \"Egypten\", \"Olympen\",\n  \"SU00\", \"SU01\", \"SU02\", \"SU03\", \"SU04\",\n  \"SU10\", \"SU11\", \"SU12\", \"SU13\", \"SU14\",\n  \"SU15\/16\", \"SU17\/18\", \"SU24\", \"SU25\"\n];\n\n\/\/ ====== ICS HELPERS ======\n\nfunction unfoldICSLines(text) {\n  const rawLines = text.split(\/\\r?\\n\/);\n  const lines = [];\n  for (const raw of rawLines) {\n    if (raw.startsWith(\" \") || raw.startsWith(\"\\t\")) {\n      if (lines.length > 0) lines[lines.length - 1] += raw.slice(1);\n    } else {\n      lines.push(raw);\n    }\n  }\n  return lines;\n}\n\nfunction parseICSTime(value) {\n  if (\/^\\d{8}$\/.test(value)) {\n    const y = parseInt(value.slice(0, 4), 10);\n    const m = parseInt(value.slice(4, 6), 10) - 1;\n    const d = parseInt(value.slice(6, 8), 10);\n    return new Date(y, m, d);\n  }\n  if (\/^\\d{8}T\\d{6}Z$\/.test(value)) {\n    const y = parseInt(value.slice(0, 4), 10);\n    const m = parseInt(value.slice(4, 6), 10) - 1;\n    const d = parseInt(value.slice(6, 8), 10);\n    const hh = parseInt(value.slice(9, 11), 10);\n    const mm = parseInt(value.slice(11, 13), 10);\n    const ss = parseInt(value.slice(13, 15), 10);\n    return new Date(Date.UTC(y, m, d, hh, mm, ss));\n  }\n  if (\/^\\d{8}T\\d{6}$\/.test(value)) {\n    const y = parseInt(value.slice(0, 4), 10);\n    const m = parseInt(value.slice(4, 6), 10) - 1;\n    const d = parseInt(value.slice(6, 8), 10);\n    const hh = parseInt(value.slice(9, 11), 10);\n    const mm = parseInt(value.slice(11, 13), 10);\n    const ss = parseInt(value.slice(13, 15), 10);\n    return new Date(y, m, d, hh, mm, ss);\n  }\n  return new Date(value);\n}\n\nfunction parseICSProperty(line) {\n  const idx = line.indexOf(\":\");\n  if (idx === -1) return { key: line.trim(), value: \"\" };\n  const left = line.slice(0, idx);\n  const value = line.slice(idx + 1);\n  const [key] = left.split(\";\");\n  return { key: key.trim().toUpperCase(), value };\n}\n\nfunction roomsFromLocation(locationRaw) {\n  if (!locationRaw) return [];\n  const normalized = locationRaw.replace(\/\\\\n\/g, \"\\n\");\n  return normalized\n    .split(\"\\n\")\n    .map(s => s.replace(\/^Lokal:\\s*\/i, \"\").trim())\n    .filter(s => VALID_ROOMS.includes(s));\n}\n\nfunction isOngoing(now, start, end) {\n  return start && end && now >= start && now < end;\n}\n\n\/\/ ====== MAIN LOGIC ======\n\nasync function getFreeRooms() {\n  console.log(\"=== Fetching ICS ===\");\n  const req = new Request(ICS_URL);\n  req.headers = { \"User-Agent\": \"Mozilla\/5.0 Scriptable\" };\n  const icsText = await req.loadString();\n  console.log(\"ICS Downloaded Successfully\");\n\n  const lines = unfoldICSLines(icsText);\n  console.log(`Total ICS Lines: ${lines.length}`);\n\n  const events = [];\n  let current = null;\n\n  for (const line of lines) {\n    if (line === \"BEGIN:VEVENT\") {\n      current = { start: null, end: null, location: \"\", rooms: [] };\n      continue;\n    }\n    if (line === \"END:VEVENT\") {\n      if (current) {\n        current.rooms = roomsFromLocation(current.location);\n        events.push(current);\n      }\n      current = null;\n      continue;\n    }\n    if (!current) continue;\n\n    const { key, value } = parseICSProperty(line);\n    if (key.startsWith(\"DTSTART\")) current.start = parseICSTime(value);\n    else if (key.startsWith(\"DTEND\")) current.end = parseICSTime(value);\n    else if (key === \"LOCATION\") current.location = value || \"\";\n  }\n\n  console.log(`Total Events Parsed: ${events.length}`);\n\n  const now = new Date();\n  console.log(`Current Time: ${now.toLocaleString()}`);\n\n  const busySet = new Set();\n\n  for (const ev of events) {\n    if (isOngoing(now, ev.start, ev.end)) {\n      for (const r of ev.rooms) busySet.add(r);\n    }\n  }\n\n  const freeRooms = VALID_ROOMS.filter(r => !busySet.has(r)).sort();\n  const busyRooms = VALID_ROOMS.filter(r => busySet.has(r)).sort();\n\n  console.log(`Busy Rooms: ${busyRooms.join(\", \") || \"None\"}`);\n  console.log(`Free Rooms: ${freeRooms.join(\", \") || \"None\"}`);\n\n  return freeRooms;\n}\n\n\/\/ ====== WIDGET RENDERING ======\n\nasync function createWidget() {\n  const freeRooms = await getFreeRooms();\n\n  const widget = new ListWidget();\n  widget.backgroundColor = new Color(\"#1c1c1e\");\n\n  const title = widget.addText(\"Free lab rooms\");\n  title.font = Font.boldSystemFont(14);\n  title.textColor = Color.white();\n\n  widget.addSpacer(10);\n\n  if (freeRooms.length === 0) {\n    const noText = widget.addText(\"None free\");\n    noText.textColor = Color.red();\n    noText.font = Font.mediumSystemFont(12);\n  } else {\n    freeRooms.slice(0, 10).forEach(room => {\n      const t = widget.addText(room);\n      t.textColor = Color.green();\n      t.font = Font.systemFont(7);\n    });\n  }\n\n  return widget;\n}\n\n\/\/ ====== RUN \/ WIDGET MODE ======\nif (config.runsInWidget) {\n  const widget = await createWidget();\n  Script.setWidget(widget);\n  Script.complete();\n} else {\n  const widget = await createWidget();\n  widget.presentSmall();\n}",
  "share_sheet_inputs" : [

  ]
}